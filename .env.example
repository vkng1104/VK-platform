POSTGRES_PORT=5434
POSTGRES_TEST_PORT=5435
IAM_POSTGRES_PORT=5436
IAM_POSTGRES_TEST_PORT=5438
API_PORT=8080
IAM_PORT=8081
WEB_PORT=3000

DATABASE_URL=postgres://vk_platform:vk_platform@localhost:5434/vk_platform?sslmode=disable
TEST_DATABASE_URL=postgres://vk_platform:vk_platform@localhost:5435/vk_platform_test?sslmode=disable
API_ADDR=:8080
API_BASE_URL=http://localhost:8080
IAM_DATABASE_URL=jdbc:postgresql://localhost:5436/vk_platform_iam
IAM_TEST_DATABASE_URL=jdbc:postgresql://localhost:5438/vk_platform_iam_test
IAM_DATABASE_USERNAME=vk_platform_iam
IAM_DATABASE_PASSWORD=vk_platform_iam
IAM_BASE_URL=http://localhost:8081

# Authentication email OTP is disabled unless the Gmail provider and every value below are configured.
EMAIL_PROVIDER=disabled
EMAIL_FROM_ADDRESS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_OTP_PEPPER=
EMAIL_RATE_LIMIT_SECRET=

# Read-only source URLs used by `make db-seed-local SOURCE_ENV=...`.
SEED_DEVELOPMENT_DATABASE_URL=
SEED_PRODUCTION_DATABASE_URL=

# Server-only configuration for verified CV-link access.
CV_ACCESS_SECRET=replace-with-at-least-32-random-characters
CV_GOOGLE_DRIVE_URL=
